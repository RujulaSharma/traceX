# TraceX Environment Configuration

# Application
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL Database
POSTGRES_USER=tracex
POSTGRES_PASSWORD=tracex_dev_password
POSTGRES_DB=tracex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tracex:tracex_dev_password@localhost:5432/tracex

# For local development without PostgreSQL (uses SQLite)
# DATABASE_URL=sqlite:///./tracex.db

# Detection Engine Thresholds (Phase 2)
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_MINUTES=5

LOGIN_AFTER_FAILURES_THRESHOLD=3
LOGIN_AFTER_FAILURES_WINDOW_MINUTES=10

PORT_SCAN_THRESHOLD=5
PORT_SCAN_WINDOW_MINUTES=5

PRIVILEGE_ESCALATION_WINDOW_MINUTES=15

SUSPICIOUS_LOGIN_IP_THRESHOLD=2
SUSPICIOUS_LOGIN_WINDOW_HOURS=24
