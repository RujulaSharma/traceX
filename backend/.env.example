# TraceX Backend Environment Configuration (Production & Development)

# Application Environment (production, staging, development)
APP_ENV=production
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Hosting dynamic port (automatically set by Render)
# PORT=10000

# Database Configuration
# Render PostgreSQL Internal/External URL (postgres:// or postgresql://)
DATABASE_URL=postgresql://tracex:tracex_dev_password@localhost:5432/tracex
# For local dev SQLite fallback:
# DATABASE_URL=sqlite:///./tracex.db

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-tracex-app.vercel.app

# Optional dedicated frontend URL
FRONTEND_URL=https://your-tracex-app.vercel.app

# Security Detection Engine Thresholds
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_MINUTES=5
LOGIN_AFTER_FAILURES_THRESHOLD=3
LOGIN_AFTER_FAILURES_WINDOW_MINUTES=10
PORT_SCAN_THRESHOLD=5
PORT_SCAN_WINDOW_MINUTES=5
PRIVILEGE_ESCALATION_WINDOW_MINUTES=15
SUSPICIOUS_LOGIN_IP_THRESHOLD=2
SUSPICIOUS_LOGIN_WINDOW_HOURS=24
